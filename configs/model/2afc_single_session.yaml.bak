_target_: lfads_torch.model.LFADS
cell_clip: 5.0
ci_enc_dim: 64
ci_lag: 1
co_dim: 4
co_prior:
  _target_: lfads_torch.modules.priors.AutoregressiveMultivariateNormal
  nvar: 0.1
  shape: ${model.co_dim}
  tau: 10.0
con_dim: 64
dropout_rate: 0.2
encod_data_dim: 205
encod_seq_len: 125
ext_input_dim: 0
fac_dim: 50
gen_dim: 128
ic_dim: 64
ic_enc_dim: 64
ic_enc_seq_len: 0
ic_post_var_min: 0.0001
ic_prior:
  _target_: lfads_torch.modules.priors.MultivariateNormal
  mean: 0
  shape: ${model.ic_dim}
  variance: 0.1
infer_aug_stack:
  _target_: lfads_torch.modules.augmentations.AugmentationStack
kl_co_scale: 1.0e-06
kl_ic_scale: 1.0e-06
kl_increase_epoch: 50
kl_start_epoch: 0
l2_ci_enc_scale: 0.0
l2_con_scale: 0.0
l2_gen_scale: 0.0
l2_ic_enc_scale: 0.0
l2_increase_epoch: 50
l2_start_epoch: 0
loss_scale: 10000.0
lr_adam_beta1: 0.9
lr_adam_beta2: 0.999
lr_adam_epsilon: 1.0e-08
lr_decay: 0.95
lr_init: 0.003
lr_patience: 8
lr_scheduler: false
lr_stop: 1.0e-05
readin:
- _target_: torch.nn.Identity
readout:
  _target_: torch.nn.ModuleList
  modules:
  - _target_: lfads_torch.modules.readin_readout.FanInLinear
    in_features: ${model.fac_dim}
    out_features: ${model.encod_data_dim}
recon_reduce_mean: true
recon_seq_len: 125
reconstruction:
- _target_: lfads_torch.modules.recons.Poisson
train_aug_stack:
  _target_: lfads_torch.modules.augmentations.AugmentationStack
  batch_order:
  - 0
  loss_order:
  - 0
  transforms:
  - _target_: lfads_torch.modules.augmentations.CoordinatedDropout
    cd_pass_rate: 0.0
    cd_rate: 0.2
    ic_enc_seq_len: ${model.ic_enc_seq_len}
variational: true
weight_decay: 0.0001
